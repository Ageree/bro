+    def track_unapplied(self, action, before, after, text, scope):
+        """Inputs whose effect waits to be applied. An input made in a dialog, form or floating panel (`scope`, from
+        the executor, with a digest of the page's text outside it just before the input) that set a value is
+        pending while the URL, the document and that outside text stay as they were: then the page has not taken it
+        in (a salary typed into a filter dialog whose "Показать 982 вакансии" is unpressed; dates picked in a search
+        panel that was not submitted). Any of them changing (results reloaded, a navigation) applies or drops it."""
+        state = self.state
+        doc = (after.get("marker") or [None])[0]
+        digests = after.get("scopes") or {}
+        pending = self.prune_unapplied(after)
+        if not scope or after["url"] != before["url"] or doc != (before.get("marker") or [None])[0]:
+            return
+        if digests.get(str(scope["id"])) != scope["outside"]:  # the page outside already took it in
+            return
+        changed, fields = edits(before, after)
+        if action["kind"] == "fill":
+            value = text
+        elif action["kind"] == "select":
+            value = action["label"].split(" → ")[-1]
+        elif changed:  # the clicked element's own change, if it has one
+            name, old, new = next((c for c in changed if c[0] == action["label"].split(" → ")[0][:40]), changed[0])
+            value = f"{name!r}: {old[:40]!r} → {new[:40]!r}"
+        elif fields:
+            value = "a form field changed"
+        else:
+            return
+        pending.append({"step": state["history"][-1]["step"], "action": action["label"].split(" → ")[0][:60],
+                        "value": value, "in": scope.get("label") or "", "scope": scope["id"],
+                        "outside": scope["outside"], "url": after["url"], "doc": doc})
+
+    def prune_unapplied(self, page):
+        """The pending inputs that this observation still shows unapplied: same URL and document, and the text
+        outside each input's scope as it was (results that reloaded since, late, applied it)."""
+        doc, digests = (page.get("marker") or [None])[0], page.get("scopes") or {}
+        pending = self.state.setdefault("unapplied", [])
+        pending[:] = [i for i in pending if i["url"] == page["url"] and i["doc"] == doc
+                      and digests.get(str(i["scope"])) == i["outside"]]
+        return pending
+
+    def recheck_unapplied(self):
+        """A DONE while inputs wait to be applied that the model has not been told about: choose again, with them
+        named (code-observed), instead of stopping, and without DONE in that one decision (named alone, the inputs
+        did not always turn a DONE: airbnb, dates re-picked and not searched). Each input is named once this way,
+        at most UNAPPLIED_CHECKS times a run; from the next decision on DONE is offered again."""
+        state = self.state
+        pending = self.prune_unapplied(state["page"])
+        if not any(not i.get("shown") for i in pending) or state.get("unapplied_checks", 0) >= UNAPPLIED_CHECKS:
+            return False
+        state["unapplied_checks"] = state.get("unapplied_checks", 0) + 1
+        for item in pending:
+            item["shown"] = True
+        state["done_withheld"] = True
+        state["status"] = "ready"
+        if state["decisions"]:
+            state["decisions"][-1]["unapplied_recheck"] = len(pending)
+        state["elapsed_ms"] = round((time.perf_counter() - state["started_at"]) * 1000)
+        return True
+
