+# A stop is accepted only after the page had a chance to finish rendering; bounded per run.
+STOP_CHECKS = 2
+STOP_WATCH_S = 3.0
+# A DONE chosen on a page observed within a second of an in-page change may precede that change's own follow-up (a
+# debounced reload of the results that re-sorts them): it is accepted after a short watch.
+DONE_WATCH_S, QUICK_MS = 0.5, 1000
+# A target the executor refuses this many times in a row (covered, hidden) is withheld like a no-op.
+REFUSALS = 2
+# The same action from the same page state at most this often: open/close or check/uncheck cannot oscillate.
+REPEATS = 2
+# WAITs in a row that changed nothing on one page state (each up to 3-6 s) before WAIT is withheld until it changes.
+IDLE_WAITS = 2
+# A page still navigating when the run starts is read again for up to this long.
+FIRST_READ_S = 15.0
+# A DONE chosen while an input made in a dialog, form or floating panel has not taken effect yet (nothing outside it
+# changed since: "Показать 982 вакансии" still unpressed) is asked again once, with those inputs named and without
+# DONE for that one decision; at most this often per run. DONE is offered again from the decision after.
+UNAPPLIED_CHECKS = 3
+# The loop's own bookkeeping (sets, tuple-keyed counts) is not part of the inspector's JSON state.
+INTERNAL = {"browser", "withheld", "why", "tried", "refused", "visited", "rejected", "unapplied"}
+# Element state an input can set; a change in it is an edit. So is a changed name ("When: Add dates" → "Nov 12 - 15",
+# a picked day now "Selected"): only inputs whose page outside their scope stayed as it was count at all.
+EDITED = ("value", "current_value", "checked", "selected", "chips", "label")
+
+
+def action_key(action):
+    """Identity of an executable choice across observations: node and kind (and option), never the per-read id."""
+    if action.get("node") is None:
+        return (action["id"],)
+    return (action["node"], action["kind"], action.get("value") if action["kind"] == "select" else None)
+
+
+def effect(before, after, earlier=()):
+    """A short, code-observed account of what the last action changed, so the model does not repeat a no-op.
+    `earlier` are (step, fingerprint) of states seen before `before`; returning to one is called out. Everything
+    the page words itself (its title, element names, text) is quoted, apart from the code's own account."""
+    # New tabs the action opened (the browser's `tab` note): followed to the action's own site, or not followed.
+    tab, notes = after.get("tab") or {}, []
+    if tab.get("followed"):
+        notes.append(f"it opened a new tab on {tab['site']}; continued in that tab")
+    if tab.get("left"):
+        notes.append(f"the tab acted in went to {unquote(tab['left'])[:80]}, another site; closed that tab")
+    notes += [f"a new tab it opened was not followed: {unquote(url)[:80]}" for url in tab.get("not_followed", ())]
+    account = account_of(before, after, earlier)
+    return "; ".join(notes + [account]) if notes else account
+
+
+def edits(before, after):
+    """Element values, checks and selections that differ between two observations of one document, as
+    (name, old, new); plus whether any form field's value changed."""
+    old = {}
+    for a in before["actions"]:
+        if a.get("node") is not None:
+            old.setdefault(a["node"], a)
+    out, seen = [], set()
+    for a in after["actions"]:
+        b = old.get(a.get("node"))
+        if not b or a["node"] in seen:
+            continue
+        seen.add(a["node"])
+        for key in EDITED:
+            old_value, new_value = b.get(key), a.get(key)
+            if key == "label" and a["kind"] == "select":
+                continue  # a select's label names an option
+            if old_value != new_value:
+                values = [", ".join(v) if isinstance(v, list) else str(v or "") for v in (old_value, new_value)]
+                out.append((b["label"].split(" → ")[0][:40], *values))
+                break
+    # Form fields present in both (a panel that closed takes its fields away; that is no edit).
+    old_fields = {f[0]: f[1:4] for f in (before.get("page_key") or [None] * 7)[6] or ()}
+    new_fields = (after.get("page_key") or [None] * 7)[6] or ()
+    fields = any(f[0] in old_fields and old_fields[f[0]] != f[1:4] for f in new_fields)
+    return out, fields
+
+
+def account_of(before, after, earlier):
+    if after["fingerprint"] == before["fingerprint"]:
+        return "no visible change"
+    back = next((step for step, fp in reversed(earlier) if fp == after["fingerprint"]), None)
+    if back is not None:
+        return f"back to the same page state as before step {back} (no net progress)"
+    url, title = unquote(after["url"])[:120], (after.get("title") or "")[:60]
+    if (before.get("marker") or [None])[0] != (after.get("marker") or [None])[0]:
+        # A page on another site than the one acted on is said to be one: the user named a site, not this one.
+        where = "" if site(after["url"]) == site(before["url"]) else " on another site"
+        return f"opened {url}{where} (title {title!r})" if after["url"] != before["url"] else (
+            f"reloaded the page (title {title!r})")
+
+    def nodes(page):
+        out = {}
+        for a in page["actions"]:
+            if a.get("node") is not None and a["node"] not in out:
+                out[a["node"]] = a
+        return out
+
+    old, new = nodes(before), nodes(after)
+    parts = []
+    for node, a in new.items():
+        b = old.get(node)
+        if not b:
+            continue
+        name = a["label"].split(" → ")[0][:40]
+        for key in ("current_value" if a["kind"] == "select" else "value", "checked", "selected", "expanded",
+                    "chips"):
+            if b.get(key) != a.get(key):
+                old_value, new_value = (", ".join(v) if isinstance(v, list) else str(v or "") for v in
+                                        (b.get(key), a.get(key)))
+                parts.append(f"{name!r} {key}: {old_value[:40]!r} → {new_value[:40]!r}")
+    appeared = [a["label"][:30] for node, a in new.items() if node not in old]
+    gone = sum(node not in new for node in old)
+    if appeared:
+        parts.append(f"{len(appeared)} new elements, e.g. " + ", ".join(repr(x) for x in appeared[:3]))
+    if gone:
+        parts.append(f"{gone} elements disappeared")
+    if after["scroll"].get("y") != before["scroll"].get("y"):
+        parts.append("scrolled")
+    old_lines = before.get("stable_text", before["text"]).split("\n")
+    new_lines = after.get("stable_text", after["text"]).split("\n")
+    old_text, new_text = set(old_lines), set(new_lines)
+    added = [line for line in new_lines if line not in old_text]
+    removed = [line for line in old_lines if line not in new_text]
+    if added and not appeared:
+        parts.append(f"text changed, e.g. {added[0][:60]!r}")
+    elif removed and not gone:
+        parts.append(f"text removed, e.g. {removed[0][:60]!r}")
+    elif not appeared and not gone and old_lines != new_lines:
+        parts.append("the same text in a new order")  # e.g. rows re-sorted in place
+    if after["url"] != before["url"]:
+        parts.insert(0, f"URL changed to {url}")
+    return "; ".join(parts[:6]) or "page changed slightly"
+
 
