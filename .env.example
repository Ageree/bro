# Optional overrides. Vercel deployments generate the two secrets in their
# connected private Blob store and derive the URL from Vercel system variables.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# The Neon Marketplace resource injects these automatically on Vercel. `pnpm
# dev` overrides both with the local Docker Compose database.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/open_instinct
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@127.0.0.1:54329/open_instinct
# Set to neon-http only for a maintenance run that cannot open a TCP connection.
DATABASE_DRIVER=
# Optional base64-encoded 32-byte override. Generate with: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=
# Required for model inference outside Vercel. Vercel deployments use project
# OIDC for AI Gateway access instead.
AI_GATEWAY_API_KEY=
# Vercel injects BLOB_STORE_ID and VERCEL_OIDC_TOKEN when a private Blob store
# is connected. Outside Vercel, set a read-write token instead.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Optional Vercel Connect configuration.
GOOGLE_CONNECTOR_UID=
# Photon iMessage. Delivery requires the project credentials; the webhook secret
# verifies inbound Photon deliveries. The phone number is the line Bro answers
# on: the landing's «Написать бро», the sign-in screen and the workspace all
# deep-link into it, and without it the landing says onboarding is closed.
IMESSAGE_PROJECT_ID=
IMESSAGE_PROJECT_SECRET=
IMESSAGE_WEBHOOK_SECRET=
IMESSAGE_PHONE_NUMBER=
# Browser Use Cloud. The API key alone enables the `browser_task` website
# errand tool; the webhook secret verifies completion callbacks registered for
# https://<your-host>/webhooks/browser-use. The remaining four are overrides;
# BROWSER_USE_MAX_COST_USD caps what any single errand may spend.
BROWSER_USE_API_KEY=
BROWSER_USE_WEBHOOK_SECRET=
BROWSER_USE_MAX_COST_USD=
BROWSER_USE_PROXY_COUNTRY=
# A proxy of your own, used instead of the hosted pool. Host and port turn it on.
BROWSER_USE_PROXY_HOST=
BROWSER_USE_PROXY_PORT=
BROWSER_USE_PROXY_USERNAME=
BROWSER_USE_PROXY_PASSWORD=
# Optional, together with the host and port above: the proxy username with
# {session} where a fresh token goes, so a retry after an anti-bot wall gets a
# different exit from the provider. Without a proxy of your own it does nothing.
BROWSER_USE_PROXY_ROTATING_USERNAME=
BROWSER_USE_MODEL=
BROWSER_USE_BASE_URL=
# Telegram. The bot token and webhook secret power the /eve/v1/telegram webhook;
# the bot username (without @) builds the one-time account link.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
# OpenRouter. Setting the key routes every model call through OpenRouter
# instead of the Vercel AI Gateway. The model id is the default until a
# workspace chooses one; the context window is required because the Gateway
# catalog does not list OpenRouter ids. Provider order pins upstream hosts, and
# the reasoning effort stays off unless set to low, medium, or high.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_MODEL_CONTEXT_TOKENS=1000000
OPENROUTER_PROVIDER_ORDER=
OPENROUTER_REASONING_EFFORT=
# Model that reads the OpenRouter web plugin's results for the `web_search`
# tool. Defaults to OPENROUTER_MODEL.
OPENROUTER_SEARCH_MODEL=
# Voice notes from Telegram and iMessage are transcribed through OpenRouter's
# audio endpoint with the same key; without OPENROUTER_API_KEY the person is
# told that voice is not supported. The fallback model takes over when the
# first one rejects a clip. The language is an ISO 639-1 hint; `auto` lets the
# model guess.
OPENROUTER_STT_MODEL=qwen/qwen3-asr-flash-2026-02-10
OPENROUTER_STT_FALLBACK_MODEL=openai/gpt-4o-transcribe
OPENROUTER_STT_LANGUAGE=ru
# Pictures from `generate_image` go through OpenRouter's Image API with the same
# key; without OPENROUTER_API_KEY the tool is not offered. The model must accept
# reference images, which carry the person's photos and earlier drafts.
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
# OpenRouter balance check, every ten minutes. The credits endpoint accepts
# only a management key; with it and the owner's Telegram chat id set, the
# owner is alerted through the bot when the balance falls below the threshold
# (USD), then at most daily while it stays low.
OPENROUTER_MANAGEMENT_KEY=
OPENROUTER_CREDITS_ALERT_USD=5
TELEGRAM_OWNER_CHAT_ID=
# YooKassa. Both credentials together switch billing on; with either one missing
# the deployment runs in free mode, where the free limits apply and nothing
# offers a pay link. PRICE_RUB is one month of access, in whole roubles.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
PRICE_RUB=2000
# Usage ceilings per workspace: messages on the person's local day, browser
# errands and drawn pictures on their local month. The zone comes from the Personal Info profile
# and defaults to Europe/Moscow. USAGE_LIMITS off (the default) skips these
# ceilings and the paywall entirely, for the closed beta.
USAGE_LIMITS=off
FREE_MESSAGES_PER_DAY=30
PAID_MESSAGES_PER_DAY=500
FREE_BROWSER_RUNS_PER_MONTH=5
PAID_BROWSER_RUNS_PER_MONTH=60
FREE_IMAGE_GENERATIONS_PER_MONTH=10
PAID_IMAGE_GENERATIONS_PER_MONTH=100
