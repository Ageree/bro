# Inkbox (never commit real keys)
INKBOX_API_KEY=
INKBOX_WEBHOOK_SECRET=
INKBOX_AGENT_HANDLE=bro-ageree

# Comma-separated E.164 numbers allowed to talk to Bro in v1
ALLOWED_SENDERS=

# Model: OpenRouter (this machine) or Vercel AI Gateway
OPENROUTER_API_KEY=
AI_GATEWAY_API_KEY=
# BRO_MODEL=openai/gpt-5.4-mini

# Convex cloud (filled by `npx convex dev`)
CONVEX_DEPLOYMENT=
CONVEX_URL=
BRO_INTERNAL_SECRET=

# Browser Use Cloud
BROWSER_USE_API_KEY=

# Composio Platform (project key from dashboard Getting Started)
COMPOSIO_API_KEY=

# Public origin for iMessage link cards (optional; prod default is bro-agent.vercel.app)
# BRO_PUBLIC_URL=https://bro-agent.vercel.app

# Production webhook (Vercel URL). Local tunnel fallback is inkboxwire.
# INKBOX_WEBHOOK_URL=https://your-app.vercel.app/webhooks/imessage
# Mail webhook is derived: same host, /webhooks/mail
# Also set INKBOX_API_KEY + INKBOX_WEBHOOK_URL on the Convex deployment
# (`npx convex env set`) so landing POST /access can mint identities.
# BRO_IDENTITY_CAP=10
# Dedicated iMessage line (off = shared router pool, inbound-first, ~100/day).
# Set on Convex too (`npx convex env set`) so landing POST /access claims a line.
# BRO_DEDICATED_LINE=1

# eve base URL for background wakeups (set on the CONVEX deployment env)
# EVE_URL=https://bro-agent.vercel.app

# YooKassa (set on the Convex deployment). Empty keys = free mode + limits.
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# BRO_PRICE_RUB=990
# BRO_PAY_BASE=https://<deployment>.convex.site
# BRO_PAY_RETURN_URL=https://bro-agent.vercel.app
# Limits: BRO_FREE_MSGS_PER_DAY=30 BRO_PAID_MSGS_PER_DAY=500
#          BRO_FREE_BROWSER_JOBS_PER_MONTH=5 BRO_PAID_BROWSER_JOBS_PER_MONTH=60
