# Inkbox (never commit real keys)
INKBOX_API_KEY=
INKBOX_WEBHOOK_SECRET=
INKBOX_AGENT_HANDLE=bro-xxxxxxxx

# Comma-separated E.164 numbers allowed to talk to Bro in v1
ALLOWED_SENDERS=

# Model: OpenRouter (this machine) or Vercel AI Gateway
OPENROUTER_API_KEY=
AI_GATEWAY_API_KEY=
# Default OpenRouter model is deepseek/deepseek-v4.1-flash (1M context). Override with BRO_MODEL.
# BRO_MODEL=deepseek/deepseek-v4.1-flash
# Required for a custom BRO_MODEL so eve compaction knows the window. Omit to skip.
# BRO_MODEL_CONTEXT_TOKENS=1000000
# OpenRouter reserves max_tokens against the account balance before running. Unset = 8192.
# BRO_MAX_OUTPUT_TOKENS=8192
# DeepSeek thinks before the first visible token (even effort=low ≈ 1,600 hidden tokens).
# Unset/off = no thinking phase, first token is visible. low|high|max re-enables it.
# BRO_REASONING_EFFORT=off
# OpenRouter picks the lowest-latency host (sticky prompt cache stays on). Pin a list instead:
# BRO_OPENROUTER_PROVIDER_ORDER=baseten,fireworks
# One Spectrum (Photon) app per instance; "0" boots one per send (slow, for debugging only).
# BRO_PHOTON_KEEPALIVE=1
# Fast-ack lane: sends a 2-5 word status line («ищу на вб») before the real turn starts.
# Unset/1/on = enabled. 0/off/false disables it.
# BRO_FAST_ACK=1
# Hard time budget (ms) for the fast-ack model call before the channel gives up on it.
# BRO_FAST_ACK_BUDGET_MS=700
# Model for the fast-ack call. Unset falls back to BRO_MODEL, then the DeepSeek default.
# BRO_FAST_ACK_MODEL=
# Per-errand instruction brief: composes the ЦЕЛЬ line of a browser errand from
# the errand plus what Bro already knows about the person, instead of one static
# rules block. Unset/1/on = enabled; 0/off/false falls back to the static text.
# BRO_ERRAND_BRIEF=1
# BRO_ERRAND_BRIEF_BUDGET_MS=1500
# Unset falls back to BRO_FAST_ACK_MODEL, then BRO_MODEL, then the default.
# BRO_ERRAND_BRIEF_MODEL=

# Voice notes (OpenRouter STT). Default qwen/qwen3-asr-flash-2026-02-10; "auto" language = detect.
# BRO_STT_MODEL=qwen/qwen3-asr-flash-2026-02-10
# BRO_STT_FALLBACK_MODEL=openai/gpt-4o-transcribe
# BRO_STT_LANGUAGE=ru
# BRO_STT_TIMEOUT_MS=20000

# Convex cloud (filled by `npx convex dev`)
CONVEX_DEPLOYMENT=
CONVEX_URL=
BRO_INTERNAL_SECRET=

# Supermemory (optional, paid): automatic conversation memory + Instinct-style
# archive of connected apps (hourly Gmail/Calendar copies, semantic recall).
# Key from https://console.supermemory.ai — without it Bro keeps Convex-only memory.
# SUPERMEMORY_API_KEY=
# Hard budget (ms) for the turn-start recall search. It was 900 ms, and production
# missed it on literally every turn — both halves logged TimeoutError, so Bro ran
# with no memory at all. Default is now 2000. `recall …` log lines carry the
# measured latency of each attempt: tune this from those, not by guessing.
# BRO_RECALL_BUDGET_MS=2000

# TinyFish Search + Fetch (free at $0 wallet; Agent/Browser APIs are paid — Bro does not call those).
# Key from https://agent.tinyfish.ai/api-keys — without it web_search / web_fetch tell the model they are unset.
# TINYFISH_API_KEY=

# Browser Use Cloud
BROWSER_USE_API_KEY=
# BROWSERUSE_API_KEY=
# Optional: reuse a known Cloud profile id. Bro otherwise creates one per person
# and saves logins when they open the chat link. BROWSER_USE_PROFILE_ID only
# applies to the one tenant named by BROWSER_USE_PROFILE_PHONE (E.164) below —
# every other tenant still gets their own hashed per-tenant profile.
# BROWSER_USE_PROFILE_ID=
# BROWSER_USE_PROFILE_PHONE=
# Optional ISO 3166-1 alpha-2 for residential proxy (API v4 browserSettings.proxyCountryCode).
# Unset = Browser Use default (US). Example for RU sites:
# BROWSERUSE_PROXY_COUNTRY=ru
# BRO_BROWSER_PROXY=ru        # fallback proxy country if BROWSERUSE_PROXY_COUNTRY is unset ("none" to disable)
# BRO_BROWSER_MAX_COST=1      # USD cap per cloud browser run
# BRO_BROWSER_MODEL=gpt-5.6-luna  # Cloud V4 recommended model (default)

# Composio Platform (project key from dashboard Getting Started)
COMPOSIO_API_KEY=

# Composio push-watcher webhook secret — set on the Convex deployment, not here:
#   npm run composio:webhook https://<deployment>.convex.site/composio
#   npx convex env set COMPOSIO_WEBHOOK_SECRET <secret printed once>
# COMPOSIO_WEBHOOK_SECRET=
# COMPOSIO_WEBHOOK_URL=https://<deployment>.convex.site/composio

# Public origin for iMessage link cards (optional; prod default is bro-agent.vercel.app)
# BRO_PUBLIC_URL=https://bro-agent.vercel.app

# Production webhook (Vercel URL). Local tunnel fallback is inkboxwire.
# INKBOX_WEBHOOK_URL=https://your-app.vercel.app/webhooks/imessage
# Mail webhook is derived: same host, /webhooks/mail
# Also set INKBOX_API_KEY + INKBOX_WEBHOOK_URL on the Convex deployment
# (`npx convex env set`) so landing POST /access can mint identities.
# BRO_IDENTITY_CAP=100
# Identity creations per hour on POST /access (iOS UA is spoofable; each buys an Inkbox identity)
# BRO_ACCESS_CREATES_PER_HOUR=20
# Dedicated Inkbox iMessage line is unused for chat. Chat is Photon Spectrum Pro.
# BRO_DEDICATED_LINE=1

# Photon Spectrum (iMessage chat). Never commit real values.
# SPECTRUM_PROJECT_ID=
# SPECTRUM_PROJECT_SECRET=
# SPECTRUM_WEBHOOK_SECRET=

# eve base URL for background wakeups (set on the CONVEX deployment env)
# EVE_URL=https://bro-agent.vercel.app

# YooKassa (set on the Convex deployment). Empty keys = free mode + limits.
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# BRO_PRICE_RUB=2000
# BRO_PAY_BASE=https://<deployment>.convex.site
# BRO_PAY_RETURN_URL=https://bro-agent.vercel.app
# Limits: BRO_FREE_MSGS_PER_DAY=30 BRO_PAID_MSGS_PER_DAY=500
#          BRO_FREE_BROWSER_JOBS_PER_MONTH=5 BRO_PAID_BROWSER_JOBS_PER_MONTH=60

# Kernel cloud browsers (worker subagent). Without it worker fails clearly; browser_task keeps working.
KERNEL_API_KEY=

# Vault master key — set on the Convex deployment. Losing or rotating it
# makes existing vault items undecryptable. Generate: openssl rand -base64 32
# BRO_VAULT_KEY=

# Kernel proxy: country default ru, "none" disables. BRO_KERNEL_PROXY_ID overrides country.
# BRO_KERNEL_PROXY_COUNTRY=ru
# BRO_KERNEL_PROXY_ID=
# Browser VM region; Kernel defaults to us-east. us-east | eu-west | ap-southeast
# BRO_KERNEL_REGION=eu-west

# Vercel Sandbox (eve only; never Convex). On Vercel, OIDC is enough.
# Local / explicit: VERCEL_TOKEN + optional team/project.
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=

# Public cabinet origin for vault setup links (root agent).
# BRO_CABINET_BASE=https://bro-agent.vercel.app

# Telegram — second channel on the same iMessage tenant (mail/apps stay).
# Create a bot with BotFather, then: npm run telegram:webhooks
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=BroConciergeBot
# TELEGRAM_WEBHOOK_SECRET=
