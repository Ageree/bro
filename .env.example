# Inkbox (never commit real keys)
INKBOX_API_KEY=
INKBOX_WEBHOOK_SECRET=
INKBOX_AGENT_HANDLE=bro-ageree

# Comma-separated E.164 numbers allowed to talk to Bro in v1
ALLOWED_SENDERS=

# Model: OpenRouter (this machine) or Vercel AI Gateway
OPENROUTER_API_KEY=
AI_GATEWAY_API_KEY=
# Default OpenRouter model is z-ai/glm-5.3-flash (1M context). Override with BRO_MODEL.
# BRO_MODEL=z-ai/glm-5.3-flash
# Required for a custom BRO_MODEL so eve compaction knows the window. Omit to skip.
# BRO_MODEL_CONTEXT_TOKENS=1000000

# Voice notes (OpenRouter STT). Default qwen/qwen3-asr-flash-2026-02-10; "auto" language = detect.
# BRO_STT_MODEL=qwen/qwen3-asr-flash-2026-02-10
# BRO_STT_FALLBACK_MODEL=openai/gpt-4o-transcribe
# BRO_STT_LANGUAGE=ru
# BRO_STT_TIMEOUT_MS=20000

# Convex cloud (filled by `npx convex dev`)
CONVEX_DEPLOYMENT=
CONVEX_URL=
BRO_INTERNAL_SECRET=

# Supermemory (optional, paid): automatic conversation memory + Instinct-style
# archive of connected apps (hourly Gmail/Calendar copies, semantic recall).
# Key from https://console.supermemory.ai — without it Bro keeps Convex-only memory.
# SUPERMEMORY_API_KEY=

# Browser Use Cloud
BROWSER_USE_API_KEY=
# BROWSERUSE_API_KEY=
# Optional: reuse a known Cloud profile id. Bro otherwise creates one per person
# and saves logins when they open the chat link.
# BROWSER_USE_PROFILE_ID=
# Optional ISO 3166-1 alpha-2 for residential proxy (API v4 browserSettings.proxyCountryCode).
# Unset = Browser Use default (US). Example for RU sites:
# BROWSERUSE_PROXY_COUNTRY=ru
# BRO_BROWSER_PROXY=ru        # fallback proxy country if BROWSERUSE_PROXY_COUNTRY is unset ("none" to disable)
# BRO_BROWSER_MAX_COST=1      # USD cap per cloud browser run
# BRO_BROWSER_MODEL=          # override cloud browser model (default: cloud's)

# Composio Platform (project key from dashboard Getting Started)
COMPOSIO_API_KEY=

# Composio push-watcher webhook secret — set on the Convex deployment, not here:
#   npm run composio:webhook https://<deployment>.convex.site/composio
#   npx convex env set COMPOSIO_WEBHOOK_SECRET <secret printed once>
# COMPOSIO_WEBHOOK_SECRET=
# COMPOSIO_WEBHOOK_URL=https://<deployment>.convex.site/composio

# Public origin for iMessage link cards (optional; prod default is bro-agent.vercel.app)
# BRO_PUBLIC_URL=https://bro-agent.vercel.app

# Production webhook (Vercel URL). Local tunnel fallback is inkboxwire.
# INKBOX_WEBHOOK_URL=https://your-app.vercel.app/webhooks/imessage
# Mail webhook is derived: same host, /webhooks/mail
# Also set INKBOX_API_KEY + INKBOX_WEBHOOK_URL on the Convex deployment
# (`npx convex env set`) so landing POST /access can mint identities.
# BRO_IDENTITY_CAP=100
# Dedicated iMessage line (off = shared router pool, inbound-first, ~100/day).
# Set on Convex too (`npx convex env set`) so landing POST /access claims a line.
# BRO_DEDICATED_LINE=1

# eve base URL for background wakeups (set on the CONVEX deployment env)
# EVE_URL=https://bro-agent.vercel.app

# YooKassa (set on the Convex deployment). Empty keys = free mode + limits.
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# BRO_PRICE_RUB=2000
# BRO_PAY_BASE=https://<deployment>.convex.site
# BRO_PAY_RETURN_URL=https://bro-agent.vercel.app
# Limits: BRO_FREE_MSGS_PER_DAY=30 BRO_PAID_MSGS_PER_DAY=500
#          BRO_FREE_BROWSER_JOBS_PER_MONTH=5 BRO_PAID_BROWSER_JOBS_PER_MONTH=60

# Kernel cloud browsers (worker subagent). Without it worker fails clearly; browser_task keeps working.
KERNEL_API_KEY=

# Vault master key — set on the Convex deployment. Losing or rotating it
# makes existing vault items undecryptable. Generate: openssl rand -base64 32
# BRO_VAULT_KEY=

# Kernel proxy: country default ru, "none" disables. BRO_KERNEL_PROXY_ID overrides country.
# BRO_KERNEL_PROXY_COUNTRY=ru
# BRO_KERNEL_PROXY_ID=
# Browser VM region; Kernel defaults to us-east. us-east | eu-west | ap-southeast
# BRO_KERNEL_REGION=eu-west

# Public cabinet origin for vault setup links (root agent).
# BRO_CABINET_BASE=https://bro-agent.vercel.app
