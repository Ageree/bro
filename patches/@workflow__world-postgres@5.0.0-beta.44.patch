+// Bro: active runs re-enqueued at start go behind new work (graphile runs
+// numerically smaller priorities first) and a few per second. The stock
+// `reenqueueActiveRuns` queued every active run due at once and was awaited
+// before eve served: on 18.10 that was 1124 parked sessions, and a person's
+// new turn waited 36–58 s behind them after each restart. Replaying a parked
+// run is a no-op, and a run's own jobs (returned by `world-unlock.sh`, a
+// hook's resume, a sleep's wake-up) still run first, so the recovery only
+// matters for a run whose enqueue was lost — it now comes within minutes.
+const RECOVERY_PRIORITY = 10;
+const RECOVERY_RUNS_PER_SECOND = 3;
+async function recoverActiveRuns(runs, enqueue, namespace, stopped) {
+    const workflowQueuePrefix = getQueueTopicPrefix('workflow', resolveQueueNamespace(namespace));
+    const startedAt = Date.now();
+    let queued = 0;
+    let cursor;
+    let hasMore = true;
+    try {
+        while (hasMore && !stopped()) {
+            const page = await runs.list({
+                status: ['pending', 'running'],
+                resolveData: 'none',
+                pagination: { cursor },
+            });
+            for (const run of page.data) {
+                if (stopped())
+                    break;
+                try {
+                    await enqueue(`${workflowQueuePrefix}${run.workflowName}`, { runId: run.runId }, {
+                        delaySeconds: Math.floor(queued / RECOVERY_RUNS_PER_SECOND),
+                        priority: RECOVERY_PRIORITY,
+                    });
+                    queued++;
+                }
+                catch (err) {
+                    console.warn(`[world-postgres] Failed to re-enqueue run ${run.runId}: ${err}`);
+                }
+            }
+            hasMore = page.hasMore;
+            cursor = page.cursor ?? undefined;
+        }
+    }
+    catch (err) {
+        console.warn(`[world-postgres] Active run recovery stopped: ${err}`);
+    }
+    console.info('[world-postgres] recovery queued', {
+        runs: queued,
+        queueMs: Date.now() - startedAt,
+        spreadSeconds: Math.floor(queued / RECOVERY_RUNS_PER_SECOND),
+    });
+}
