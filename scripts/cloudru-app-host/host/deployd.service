[Unit]
Description=Bro deployd (releases, env, sites; 127.0.0.1:8095 behind Caddy on the ops host)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/bro/app-host/deployd.py serve
Restart=always
RestartSec=2
UMask=0077

[Install]
WantedBy=multi-user.target
