[Unit]
Description=Bro web (Next standalone server on 127.0.0.1:3000 behind Caddy)
After=network-online.target
Wants=network-online.target
# api.telegram.org answers from Cloud.ru only through tg-egress (its /etc/hosts line and REDIRECT rule):
# start after it. Wants, not Requires: the app serves the web without Telegram.
After=bro-tg-egress.service
Wants=bro-tg-egress.service
# Without bro's egress rules (no metadata service, no deployd) the app does not start.
Requires=bro-egress.service
After=bro-egress.service
# No release yet: nothing to start (deployd starts it after the first switch).
ConditionPathExists=/srv/bro/current/web/server.js

[Service]
Type=simple
User=bro
Group=bro
WorkingDirectory=/srv/bro/current/web
EnvironmentFile=/etc/bro/env
Environment=NODE_ENV=production TZ=UTC PORT=3000 HOSTNAME=127.0.0.1
# The heap cap makes V8 collect before the VM runs out of memory, on a 4 GB VM shared with Caddy, deployd, the
# bridge and tg-egress. Takes effect at the next restart. No MemoryHigh/MemoryMax yet: a cgroup limit needs
# the peaks measured on production first (docs/dev-notes.md).
ExecStart=/usr/local/bin/node --max-old-space-size=640 server.js
Restart=always
RestartSec=3
# Next exits at once on SIGTERM (code 143): a planned stop or restart, not a failure.
SuccessExitStatus=143
TimeoutStopSec=30
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
