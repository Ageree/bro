[Unit]
Description=Bro eve (agent, channels, schedules and the Postgres Workflow world on 127.0.0.1:4274)
After=network-online.target
Wants=network-online.target
# api.telegram.org answers from Cloud.ru only through tg-egress (its /etc/hosts line and REDIRECT rule):
# start after it. Wants, not Requires: the app serves the web without Telegram.
After=bro-tg-egress.service
Wants=bro-tg-egress.service
# Without bro's egress rules (no metadata service, no deployd) the app does not start.
Requires=bro-egress.service
After=bro-egress.service
ConditionPathExists=/srv/bro/current/eve/server/index.mjs

[Service]
Type=simple
User=bro
Group=bro
WorkingDirectory=/srv/bro/current/eve
EnvironmentFile=/etc/bro/env
# The Nitro server itself, not `eve start`: that wrapper keeps every line of its child's output in memory.
# TZ=UTC: Nitro's scheduler reads cron in the process's zone, Vercel Cron in UTC. The world delivers its
# queue to this process over loopback: 127.0.0.1, so `localhost` never goes to ::1.
Environment=NODE_ENV=production TZ=UTC PORT=4274 HOST=127.0.0.1
Environment=WORKFLOW_LOCAL_BASE_URL=http://127.0.0.1:4274
# Before every start (release, rollback, restart, crash, reboot) the queue jobs the previous eve held go back
# to the queue (world-unlock.sh, host code): eve's SIGTERM exit leaves them locked, and a turn cut mid-step
# otherwise resumed 14 minutes later. The leading - starts eve even when the database does not answer.
ExecStartPre=-/usr/bin/timeout 30 /bin/bash /opt/bro/app-host/world-unlock.sh
# Eve (the agent, its schedules and the Postgres Workflow world) shares a 4 GB VM with Caddy, deployd, the bridge and tg-egress. The heap cap makes V8 collect
# before the cgroup limit is near; MemoryHigh throttles and reclaims (the swap file helps there); MemoryMax is the
# line past which the kernel kills this unit alone, and Restart=always brings it back, instead of the OOM killer
# choosing among all of them.
MemoryHigh=1536M
MemoryMax=2G
ExecStart=/usr/local/bin/node --max-old-space-size=1280 server/index.mjs
Restart=always
RestartSec=3
# eve exits at once on SIGTERM (code 143); the world resumes its open steps after world-unlock.sh.
SuccessExitStatus=143
TimeoutStopSec=30
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
