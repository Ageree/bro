[Unit]
Description=Bro watchdog (Next, eve and Caddy health; Telegram to the owner)
# api.telegram.org answers from Cloud.ru only through tg-egress (its /etc/hosts line and REDIRECT rule):
# start after it. Wants, not Requires: the app serves the web without Telegram.
After=bro-tg-egress.service
Wants=bro-tg-egress.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/bro/app-host/watchdog.py
# Probes take up to 25 s and each alert up to 15 s (four checks): 60 s could cut a tick short.
TimeoutStartSec=120
