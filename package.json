    "@convex-dev/crons": "^0.2.2",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/workflow": "^0.4.6",
    "@convex-dev/workpool": "^0.4.10",
    "@inkbox/sdk": "^0.6.4",
    "@onkernel/sdk": "^0.97.0",
    "@supermemory/eve": "^0.1.1",
    "@vercel/connect": "1.0.0",
