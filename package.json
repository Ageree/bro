{
  "name": "bro",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "eve build",
    "vercel-build": "mkdir -p public && cp index.html oferta.html cabinet.html vault.html public/ && cp -R assets public/",
    "dev": "eve dev",
    "dev:local": "bash scripts/dev-local.sh",
    "tunnel": "node --experimental-strip-types scripts/inkbox-tunnel.ts",
    "webhooks": "node --experimental-strip-types scripts/setup-inkbox-webhooks.ts",
    "memory:check": "node --experimental-strip-types scripts/memory-check.ts",
    "browser:check": "node --experimental-strip-types scripts/browser-policy-check.ts",
    "access:check": "node --experimental-strip-types scripts/access-policy-check.ts",
    "dedicated:check": "node --experimental-strip-types scripts/dedicated-line-check.ts",
    "composio:check": "node --env-file=.env.local --experimental-strip-types scripts/composio-check.ts",
    "composio:isolation": "node --env-file=.env.local --experimental-strip-types scripts/composio-isolation.ts",
    "connect-link:check": "node --experimental-strip-types scripts/connect-link-check.ts",
    "jobs:check": "node --experimental-strip-types scripts/jobs-check.ts",
    "imessage:check": "node --experimental-strip-types scripts/imessage-text-check.ts",
    "billing:check": "node --experimental-strip-types scripts/billing-check.ts",
    "cabinet:check": "node --experimental-strip-types scripts/cabinet-check.ts",
    "types:check": "tsc --noEmit",
    "vault:check": "node --experimental-strip-types scripts/vault-check.ts",
    "worker:check": "node --experimental-strip-types scripts/worker-check.ts",
    "wakeups:check": "node --experimental-strip-types scripts/wakeups-check.ts",
    "provision:inkbox": "node --experimental-strip-types scripts/provision-inkbox.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.47",
    "@composio/core": "^0.17.0",
    "@composio/experimental": "^0.2.2",
    "@convex-dev/crons": "^0.2.2",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/workflow": "^0.4.6",
    "@convex-dev/workpool": "^0.4.10",
    "@inkbox/sdk": "^0.6.4",
    "@onkernel/sdk": "^0.97.0",
    "@supermemory/eve": "^0.1.1",
    "@vercel/connect": "1.0.0",
    "ai": "^7.0.58",
    "convex": "^1.45.0",
    "convex-helpers": "^0.1.123",
    "eve": "^0.47.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  }
}
