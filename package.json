    "voice:check": "node --experimental-strip-types scripts/voice-check.ts",
    "worker:check": "node --experimental-strip-types scripts/worker-check.ts",
    "wakeups:check": "node --experimental-strip-types scripts/wakeups-check.ts",
    "outcome:check": "node --experimental-strip-types scripts/browser-outcome-check.ts",
    "progress:check": "node --experimental-strip-types scripts/browser-progress-check.ts",
    "phrasing:check": "node --experimental-strip-types scripts/phrasing-check.ts",
