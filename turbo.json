{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build:app": {
      "dependsOn": ["^build:app"],
      "env": [
        "ACCESS_*",
        "AGENTMAIL_*",
        "BETTER_AUTH_*",
        "BLOB_*",
        "BROWSER_BACKEND",
        "BROWSER_HOST_*",
        "BROWSER_POOL_*",
        "BROWSER_SANDBOX_*",
        "BROWSER_STATE_*",
        "BROWSER_USE_*",
        "BROWSER_VM_*",
        "CLOUDRU_*",
        "COMPOSIO_*",
        "DATABASE_DRIVER",
        "DATABASE_URL",
        "ELEVENLABS_*",
        "EVE_NEXT_*",
        "EVE_SCHEDULES",
        "FREE_*",
        "IMESSAGE_*",
        "MAILRU_MAIL_*",
        "YANDEX_MAIL_*",
        "YANDEX_API_WORKSPACES",
        "YANDEX_PURCHASE_WORKSPACES",
        "MAIL_WORKSPACES",
        "MODEL_PROVIDER",
        "MTS_EXOLVE_*",
        "NEXT_OUTPUT",
        "NODE_ENV",
        "OPENROUTER_*",
        "OPS_ALERT_*",
        "PAID_*",
        "PHONE_*",
        "PRICE_RUB",
        "ROUTERAI_*",
        "S3_*",
        "SECRET_ENCRYPTION_KEY",
        "SUPERMEMORY_*",
        "TELEGRAM_*",
        "VERCEL_*",
        "YOOKASSA_*"
      ],
      "outputs": [".next/**", "!.next/cache/**", "next-env.d.ts"]
    },
    "build:vercel": {
      "dependsOn": ["db:migrate:deploy"],
      "env": [
        "ACCESS_*",
        "AGENTMAIL_*",
        "BETTER_AUTH_*",
        "BLOB_*",
        "BROWSER_BACKEND",
        "BROWSER_HOST_*",
        "BROWSER_POOL_*",
        "BROWSER_SANDBOX_*",
        "BROWSER_STATE_*",
        "BROWSER_USE_*",
        "BROWSER_VM_*",
        "CLOUDRU_*",
        "COMPOSIO_*",
        "DATABASE_DRIVER",
        "DATABASE_URL",
        "ELEVENLABS_*",
        "EVE_SCHEDULES",
        "FREE_*",
        "IMESSAGE_*",
        "MAILRU_MAIL_*",
        "YANDEX_MAIL_*",
        "YANDEX_API_WORKSPACES",
        "YANDEX_PURCHASE_WORKSPACES",
        "MAIL_WORKSPACES",
        "MODEL_PROVIDER",
        "MTS_EXOLVE_*",
        "NODE_ENV",
        "OPENROUTER_*",
        "OPS_ALERT_*",
        "PAID_*",
        "PHONE_*",
        "PRICE_RUB",
        "ROUTERAI_*",
        "S3_*",
        "SECRET_ENCRYPTION_KEY",
        "SUPERMEMORY_*",
        "TELEGRAM_*",
        "VERCEL_*",
        "YOOKASSA_*"
      ],
      "outputs": [".next/**", "!.next/cache/**", "next-env.d.ts"]
    },
    "db:migrate": {
      "cache": false,
      "env": ["DATABASE_URL_UNPOOLED"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "db:migrate:deploy": {
      "cache": false,
      "env": ["DATABASE_URL_UNPOOLED", "VERCEL_ENV"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "dev:app": {
      "cache": false,
      "passThroughEnv": [
        "ACCESS_*",
        "AGENTMAIL_*",
        "BETTER_AUTH_*",
        "BLOB_*",
        "BROWSER_BACKEND",
        "BROWSER_HOST_*",
        "BROWSER_POOL_*",
        "BROWSER_SANDBOX_*",
        "BROWSER_STATE_*",
        "BROWSER_USE_*",
        "BROWSER_VM_*",
        "CLOUDRU_*",
        "COMPOSIO_*",
        "DATABASE_DRIVER",
        "DATABASE_URL",
        "ELEVENLABS_*",
        "EVE_SCHEDULES",
        "FREE_*",
        "IMESSAGE_*",
        "MAILRU_MAIL_*",
        "YANDEX_MAIL_*",
        "YANDEX_API_WORKSPACES",
        "YANDEX_PURCHASE_WORKSPACES",
        "MAIL_WORKSPACES",
        "MODEL_PROVIDER",
        "MTS_EXOLVE_*",
        "NODE_ENV",
        "OPENROUTER_*",
        "OPS_ALERT_*",
        "PAID_*",
        "PHONE_*",
        "PRICE_RUB",
        "ROUTERAI_*",
        "S3_*",
        "SECRET_ENCRYPTION_KEY",
        "SUPERMEMORY_*",
        "TELEGRAM_*",
        "VERCEL_*",
        "YOOKASSA_*"
      ],
      "persistent": true
    },
    "deploy:app": {
      "cache": false
    },
    "format:check": {
      "outputs": []
    },
    "knip": {
      "outputs": []
    },
    "lint:app": {
      "outputs": []
    },
    "start:app": {
      "cache": false,
      "passThroughEnv": [
        "ACCESS_*",
        "AGENTMAIL_*",
        "BETTER_AUTH_*",
        "BLOB_*",
        "BROWSER_BACKEND",
        "BROWSER_HOST_*",
        "BROWSER_POOL_*",
        "BROWSER_SANDBOX_*",
        "BROWSER_STATE_*",
        "BROWSER_USE_*",
        "BROWSER_VM_*",
        "CLOUDRU_*",
        "COMPOSIO_*",
        "DATABASE_DRIVER",
        "DATABASE_URL",
        "ELEVENLABS_*",
        "EVE_SCHEDULES",
        "FREE_*",
        "IMESSAGE_*",
        "MAILRU_MAIL_*",
        "YANDEX_MAIL_*",
        "YANDEX_API_WORKSPACES",
        "YANDEX_PURCHASE_WORKSPACES",
        "MAIL_WORKSPACES",
        "MODEL_PROVIDER",
        "MTS_EXOLVE_*",
        "NODE_ENV",
        "OPENROUTER_*",
        "OPS_ALERT_*",
        "PAID_*",
        "PHONE_*",
        "PRICE_RUB",
        "ROUTERAI_*",
        "S3_*",
        "SECRET_ENCRYPTION_KEY",
        "SUPERMEMORY_*",
        "TELEGRAM_*",
        "VERCEL_*",
        "YOOKASSA_*"
      ],
      "persistent": true
    },
    "test:app": {
      "outputs": [],
      "env": ["PHONE_TEST_DATABASE_URL"]
    },
    "types:generate": {
      "outputs": [".next/types/**", "next-env.d.ts"]
    },
    "types:check:app": {
      "dependsOn": ["types:generate"],
      "outputs": ["*.tsbuildinfo"]
    }
  }
}
