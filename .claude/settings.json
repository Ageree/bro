{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types ${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.ts",
            "timeout": 15,
            "statusMessage": "Читаю состояние репозитория…"
          }
        ]
      }
    ]
  }
}
